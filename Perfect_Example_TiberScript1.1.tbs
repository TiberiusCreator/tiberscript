/*
  Tiberian Odyssey 1.1 (Corner Spawns & Detection Distance)
  - 4 enemies now spawn precisely in the 4 corners of the map.
  - Player starts at exact center (0, 0).
  - Enemies only detect and chase the player when within range (100 units).
*/

// Global configuration using a data block.
game_config = data
  title = "Tiberian Odyssey 1.1"
  initial_hp = 100
  move_speed = 3
  enemy_damage = 10
  potion_heal = 25
  max_crystals = 5
  i_frame_ticks = 60
  music = "main_theme"
  sfx_hit = "hit_sound"
  sfx_collect = "collect_sound"
  sfx_heal = "heal_sound"
  sfx_victory = "victory_fanfare"
  sfx_game_over = "game_over_buzz"
  sfx_save = "save_chime"
  sfx_fail = "fail_sound"
  sfx_shoot = "laser_shoot"
end

// Utility functions
clampX(val) = function
  if val < -150 then return -150 end
  if val > 150 then return 150 end
  return val
end

clampY(val) = function
  if val < -90 then return -90 end
  if val > 90 then return 90 end
  return val
end

isLowHp(hp) = function
  return hp < game_config.initial_hp * 0.3
end

// Global dialogue state
dialogue_text = ""
dialogue_timer = 0

show_dialogue(msg) = function
  dialogue_text = msg
  dialogue_timer = 180
end

// Projectile weapon class
bullet_class = class
  init(bx, by, dx, dy) = function
    this.x = bx
    this.y = by
    this.vx = dx * 6
    this.vy = dy * 6
    this.alive = true
    this.mark("bullet")
  end

  update() = function
    if not this.alive then return end
    this.x += this.vx
    this.y += this.vy

    if this.x < -160 or this.x > 160 or this.y < -100 or this.y > 100 then
      this.alive = false
      this.vanish()
      return
    end

    local target = collide("enemy")
    if target and target.alive then
      target.die()
      this.alive = false
      this.vanish()
      player.score += 100
    end
  end

  draw() = function
    if not this.alive then return end
    screen.fillCircle(this.x, this.y, 4, "yellow")
  end
end

// Player class - Starts at center (0, 0)
player_class = class
  init(name_given) = function
    this.name = name_given
    this.hp = game_config.initial_hp
    this.x = 0
    this.y = 0
    this.dir_x = 1
    this.dir_y = 0
    this.score = 0
    this.crystals = 0
    this.inventory = ["Heal Potion", "Heal Potion"]
    this.damaged = false
    this.i_frames = 0
    this.mark("player")
    print("Player '" + this.name + "' ready.")
  end

  update() = function
    if this.i_frames > 0 then
      this.i_frames -= 1
    end

    local move_dx = 0
    local move_dy = 0

    if key("arrowRight").held then move_dx += 1 end
    if key("arrowLeft").held then move_dx -= 1 end
    if key("arrowUp").held then move_dy += 1 end
    if key("arrowDown").held then move_dy -= 1 end

    if move_dx != 0 or move_dy != 0 then
      this.dir_x = move_dx
      this.dir_y = move_dy
    end

    this.x += move_dx * game_config.move_speed
    this.y += move_dy * game_config.move_speed
    this.x = clampX(this.x)
    this.y = clampY(this.y)

    if key("space").hit then
      bullets.push(new bullet_class(this.x, this.y, this.dir_x, this.dir_y))
      sfx(game_config.sfx_shoot)
    end
  end

  interact() = function
    local npc = near("npc", 50)
    if npc then
      screen.text("Press E to talk to " + npc.name, 0, -80, 13, "#aaa")
      if key("e").hit then
        npc.talk()
      end
    end
  end

  take_damage(amount) = function
    if this.i_frames > 0 then return end

    this.hp -= amount
    this.i_frames = game_config.i_frame_ticks
    this.damaged = true
    sfx(game_config.sfx_hit)
    emit("impact_particles", this.x, this.y, 5)
    print(this.name + " took " + amount + " damage. HP: " + this.hp)

    if this.hp <= 0 then
      transit("gameOver")
    end
  end

  use_potion() = function
    local idx = this.inventory.indexOf("Heal Potion")
    if idx >= 0 and this.hp < game_config.initial_hp then
      this.inventory.removeAt(idx)
      this.hp = min(this.hp + game_config.potion_heal, game_config.initial_hp)
      sfx(game_config.sfx_heal)
      emit("heal_particles", this.x, this.y, 10)
      print("Used potion. HP: " + this.hp)
    elsetry idx < 0 then
      print("No potions left!")
    else
      print("Already at full health!")
    end
  end

  save() = function
    access "odyssey_save" as file do
      file.name = this.name
      file.hp = this.hp
      file.x = this.x
      file.y = this.y
      file.score = this.score
      file.crystals = this.crystals
      print("Saved!")
      sfx(game_config.sfx_save)
    end
  end

  load() = function
    if exists("odyssey_save") then
      access "odyssey_save" as file do
        this.name = file.name
        this.hp = file.hp
        this.x = file.x
        this.y = file.y
        this.score = file.score
        this.crystals = file.crystals
        print("Loaded!")
        sfx(game_config.sfx_save)
      end
    else
      print("No save found.")
    end
  end

  draw() = function
    if this.i_frames > 0 then
      if wave(0, 10) > 5 then
        screen.fillRect(this.x, this.y, 22, 22, "magenta")
      else
        screen.fillRect(this.x, this.y, 22, 22, "yellow")
      end
    else
      screen.fillRect(this.x, this.y, 22, 22, "cyan")
    end
    screen.text("HP " + this.hp, this.x, this.y + 18, 12, "white")
  end
end

// Enemy class with detection threshold
enemy_class = class
  init(id_num, spawn_x, spawn_y) = function
    this.id = "Enemy " + id_num
    this.x = spawn_x
    this.y = spawn_y
    this.speed = 0.8
    this.detect_range = 100 // Detects player within 100 units
    this.alive = true
    this.mark("enemy")
  end

  update(tx, ty) = function
    if not this.alive then return end
    local d = distance(this.x, this.y, tx, ty)

    // Pursue player only if detected within range
    if d < this.detect_range then
      if this.x < tx then this.x += this.speed end
      if this.x > tx then this.x -= this.speed end
      if this.y < ty then this.y += this.speed end
      if this.y > ty then this.y -= this.speed end

      local p = collide("player")
      if p then
        p.take_damage(game_config.enemy_damage)
      end
    end
  end

  draw() = function
    if not this.alive then return end
    screen.fillRect(this.x, this.y, 20, 20, "red")
  end

  die() = function
    print(this.id + " defeated!")
    emit("explosion_particles", this.x, this.y, 15)
    sfx("enemy_explode")
    this.alive = false
    this.vanish()
  end
end

// Crystal class
crystal_class = class
  init(cx, cy) = function
    this.x = cx
    this.y = cy
    this.collected = false
    this.mark("collectible")
  end

  draw() = function
    if this.collected then return end
    local float_y = this.y + wave(0, 4)
    alter scale=1.0, opacity=0.85 do
      screen.fillCircle(this.x, float_y, 8, "gold")
    end
  end

  collect(collector) = function
    if this.collected then return end
    this.collected = true
    collector.score += 150
    collector.crystals += 1
    sfx(game_config.sfx_collect)
    emit("sparkle_particles", this.x, this.y, 8)
    print("Crystal collected! Score: " + collector.score)
    this.vanish()
  end
end

// Base character class
character_class = class
  init(name, x, y) = function
    this.name = name
    this.x = x
    this.y = y
    this.mark("interactable")
  end

  talk() = function
    show_dialogue(this.name + ": Hello, traveler!")
  end

  draw() = function
    screen.fillRect(this.x, this.y, 20, 20, "#aaf")
    screen.text(this.name, this.x, this.y + 16, 11, "#aaf")
  end
end

// Quest giver class - Top Middle (0, 65)
quest_giver = class extends character_class
  init() = function
    super.init("Elder Tim", 0, 65)
    this.quest_given = false
    this.mark("npc")
  end

  talk() = function
    if not this.quest_given then
      show_dialogue("Elder Tim: Collect " + game_config.max_crystals + " shards to save us!")
      this.quest_given = true
      schedule(600) = function
        show_dialogue("Elder Tim: Keep searching!")
      end
    elsetry player.crystals >= game_config.max_crystals then
      show_dialogue("Elder Tim: You restored the Harmony!")
      transit("win")
    else
      local remaining = game_config.max_crystals - player.crystals
      show_dialogue("Elder Tim: Need " + remaining + " more crystals!")
    end
  end
end

// Global game objects
player = null
enemies = []
crystals = []
npcs = []
bullets = []

init() = function
  player = new player_class("Hero")

  // 4 enemies spawning in each corner of the arena
  enemies = []
  enemies.push(new enemy_class(1, -135, 75)) // Top-Left
  enemies.push(new enemy_class(2, 135, 75)) // Top-Right
  enemies.push(new enemy_class(3, -135, -75)) // Bottom-Left
  enemies.push(new enemy_class(4, 135, -75)) // Bottom-Right

  crystals = []
  crystals.push(new crystal_class(-100, -50))
  crystals.push(new crystal_class(100, -50))
  crystals.push(new crystal_class(-100, 50))
  crystals.push(new crystal_class(100, 50))
  crystals.push(new crystal_class(0, -20))

  npcs = []
  npcs.push(new quest_giver())

  bullets = []
  dialogue_text = ""
  dialogue_timer = 0

  tune(game_config.music)
  print("Welcome to " + game_config.title)
  transit("menu")
end

// Main game loop
update() = function

  during "menu" do
    screen.clear("#000033")
    screen.text(game_config.title, 0, 30, 26, "gold")
    screen.text("Press Enter to start", 0, -10, 16, "white")
    screen.text("L to load save", 0, -35, 14, "#aaa")
    if key("enter").hit then
      sfx("menu_select")
      transit("game")
    end
    if key("l").hit then
      player.load()
      transit("game")
    end
  end

  during "game" do
    screen.clear("#141428")

    player.update()
    player.interact()

    if key("h").hit then player.use_potion() end
    if key("s").hit then player.save() end

    if key("p").hit then
      transit("paused")
    end

    local gem = collide("collectible")
    if gem then
      gem.collect(player)
    end

    if player.crystals >= game_config.max_crystals then
      transit("win")
    end

    local active_bullets = []
    for b in bullets
      if b.alive then
        b.update()
        if b.alive then
          active_bullets.push(b)
        end
      end
    end
    bullets = active_bullets

    for e in enemies
      if e.alive then
        e.update(player.x, player.y)
      end
    end

    if key("r").hit then
      sfx(game_config.sfx_fail)
      attempt
        local chance = random(100)
        if chance < 30 then
          local bad = undefined_var.value
        end
        player.score += 500
        print("Risky action worked! +500 score.")
      recover
        print("Risky action failed.")
        player.take_damage(20)
      end
    end

    every(300) do
      emit("ambient_particles", random(-140, 140), random(-80, 80), 2)
    end

    view x=player.x * 0.3, y=player.y * 0.3 do
      for b in bullets
        if b.alive then b.draw() end
      end
      for e in enemies
        if e.alive then e.draw() end
      end
      for c in crystals
        if not c.collected then c.draw() end
      end
      for n in npcs
        n.draw()
      end
      player.draw()
    end

    screen.text("Score: " + player.score, -140, 85, 13, "gold")
    screen.text("Crystals: " + player.crystals + "/" + game_config.max_crystals, 0, 85, 13, "white")

    if dialogue_timer > 0 then
      dialogue_timer -= 1
      alter opacity=0.85 do
        screen.fillRect(0, -50, 240, 26, "#111827")
      end
      screen.text(dialogue_text, 0, -50, 12, "gold")
    end

    if isLowHp(player.hp) then
      screen.text("CRITICAL HP!", 0, 70, 14, "red")
      alter opacity=0.15 do
        screen.fillRect(0, 0, 320, 200, "red")
      end
    elsetry player.hp < game_config.initial_hp * 0.6 then
      screen.text("Status: Injured", 0, 70, 13, "orange")
    else
      screen.text("Status: Healthy", 0, 70, 13, "green")
    end

    screen.text("SPACE shoot H heal S save P pause", 0, -85, 11, "#555")
  end

  during "paused" do
    screen.clear("#111")
    screen.text("PAUSED", 0, 20, 28, "white")
    screen.text("Press P to resume", 0, -15, 15, "#aaa")
    silence(game_config.music)
    if key("p").hit then
      tune(game_config.music)
      transit("game")
    end
  end

  during "gameOver" do
    silence("all")
    screen.clear("black")
    screen.text("GAME OVER", 0, 25, 32, "red")
    screen.text("Score: " + player.score, 0, -5, 18, "white")
    screen.text("SPACE to restart", 0, -35, 14, "#aaa")
    sfx(game_config.sfx_game_over)
    if key("space").hit then
      init()
    end
  end

  during "win" do
    silence("all")
    screen.clear("#002200")
    screen.text("VICTORY!", 0, 30, 34, "gold")
    screen.text("Crystal of Harmony restored!", 0, 0, 15, "white")
    screen.text("Final Score: " + player.score, 0, -25, 17, "#afa")
    screen.text("SPACE for menu", 0, -55, 13, "#aaa")
    sfx(game_config.sfx_victory)
    if key("space").hit then
      init()
      transit("menu")
    end
  end

end
